[Unit]
Description=Run stock analysis at 09:30, 09:50, 11:30, 14:00, 15:30 and 16:00 KST

[Timer]
OnCalendar=Mon..Fri *-*-* 09:30:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 09:50:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 11:30:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 14:00:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 15:30:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 16:00:00 Asia/Seoul
Unit=stock-scanner@full-analysis.service
AccuracySec=1s

[Install]
WantedBy=timers.target
