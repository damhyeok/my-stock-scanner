[Unit]
Description=Collect two-hour sector flow windows

[Timer]
OnCalendar=Mon..Fri *-*-* 11:05:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 13:05:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 15:05:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 15:35:00 Asia/Seoul
Unit=stock-scanner@sector-flow.service
AccuracySec=1s

[Install]
WantedBy=timers.target
